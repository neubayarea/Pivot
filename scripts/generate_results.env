# Settings for scripts/generate_results.py: the live site's stores and models (#364). No secrets here:
# access comes from `az login`. Load with:  set -a; . scripts/generate_results.env; set +a
PIVOT_SIMS_BACKEND=blob
PIVOT_BLOB_ENDPOINT=https://pivotstore1024.blob.core.windows.net/
PIVOT_RESULTS_BACKEND=cosmos
PIVOT_COSMOS_ENDPOINT=https://pivot-cosmos.documents.azure.com:443/
PIVOT_RESULTS_TAG=2
PIVOT_PIPELINE=detect
PIVOT_FOUNDRY_ENDPOINT=https://pivot-resource.cognitiveservices.azure.com/
PIVOT_MODEL_STANDARD=standard
PIVOT_MODEL_MINI=mini
PIVOT_SIMULATOR=0
PIVOT_WHATIF_WARM=0
PIVOT_WHATIF_MAX_QUEUED=200
