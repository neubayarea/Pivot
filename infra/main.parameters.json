{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "budgetEmails": { "value": "${PIVOT_BUDGET_EMAILS}" },
    "webPubSubSku": { "value": "${PIVOT_WEBPUBSUB_SKU=Free_F1}" },
    "foundryEndpoint": { "value": "${PIVOT_FOUNDRY_ENDPOINT=}" },
    "foundryDeployment": { "value": "${PIVOT_FOUNDRY_DEPLOYMENT=}" },
    "foundryDeploymentMini": { "value": "${PIVOT_FOUNDRY_DEPLOYMENT_MINI=}" },
    "apiExists": { "value": "${SERVICE_API_RESOURCE_EXISTS=false}" },
    "workerExists": { "value": "${SERVICE_WORKER_RESOURCE_EXISTS=false}" },
    "webExists": { "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}" }
  }
}
