        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_ids",
        "claims"
      ],
      "title": "ExplanationSentence",
      "type": "object"
    },
    "Match": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "$ref": "#/$defs/Team"
        },
        "clock": {
          "default": 0,
          "maximum": 5400,
          "minimum": 0,
          "type": "integer"
        },
        "home": {
          "$ref": "#/$defs/Team"
        },
        "match_id": {
          "type": "string"
        },
        "period": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "$ref": "#/$defs/Score",
          "default": {
            "away": 0,
            "home": 0
          }
        },
        "seed": {
          "type": "integer"
        },
        "speed": {
          "default": 1,
          "enum": [
            1,
            5,
            20,
            60
          ],
          "type": "integer"
        },
        "status": {
          "enum": [
            "scheduled",
            "live",
            "paused",
            "finished"
          ],
          "type": "string"
        }
      },
      "required": [
        "match_id",
        "seed",
        "preset",
        "home",
        "away",
        "status",
        "speed",
        "clock",
        "period",
        "score"
      ],
      "title": "Match",
      "type": "object"
    },
