{
  "$defs": {
    "AgentTrace": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "enum": [
            "judge",
            "explainer",
            "verifier",
            "template",
            "translator",
            "executor",
            "comparator",
            "recap"
          ],
          "type": "string"
        },
        "chain_id": {
          "type": "string"
        },
        "input_ref": {
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "match_id": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_summary": {
          "type": "string"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "ok",
            "rejected",
            "retried",
            "degraded",
            "error"
          ],
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "trace_id": {
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "trace_id",
        "chain_id",
        "step",
        "match_id",
        "agent",
        "model",
        "prompt_hash",
        "input_ref",
        "output_summary",
        "latency_ms",
        "tokens",
        "status",
        "verdict"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "BallPosition": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "maximum": 30,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "owner_id"
      ],
      "title": "BallPosition",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "stat_ref": {
          "$ref": "#/$defs/StatRef"
        },
        "unit": {
          "enum": [
            "count",
            "pct",
            "xg",
            "index",
            "m",
            "km"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "stat_ref"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "type": "object"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "enum": [
            "match.status",
            "event.batch",
            "tracking.frame",
            "metric.updated",
            "pivot.pending",
            "pivot.confirmed",
            "pivot.degraded",
            "pivot.rejected",
            "scenario.progress",
            "scenario.completed",
            "trace.appended",
            "recap.ready"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "match_id",
        "seq",
        "ts",
        "payload"
      ],
      "title": "Envelope",
      "type": "object"
    },
