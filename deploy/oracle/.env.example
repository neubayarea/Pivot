# Every setting the server reads. Copy to .env (cp .env.example .env) and fill in, or paste the
# lines into Dokploy's Environment tab. .env is ignored by git: never commit real values.

# --- Site
# Only `local` (one process, everything in memory or on disk) exists so far
PIVOT_PROFILE=local
# Public name of this VM. No domain? Use the public IP with sslip.io, e.g. 140.238.1.2 -> 140-238-1-2.sslip.io
PIVOT_DOMAIN=140-238-1-2.sslip.io
# Where browsers open the live WebSocket. docker-compose.yml builds it from PIVOT_DOMAIN; on Dokploy set it yourself
PIVOT_WS_URL=wss://140-238-1-2.sslip.io/api/ws

# The site shows the simulated matches below and opens the first one (Ax55). The hand-made sample match
# (PIVOT_SAMPLE_MATCH=1) and the recorded demo (PIVOT_DEMO_FIXTURE=1) are test data and stay off.
# Worker and simulator inside the same process: 1 on, 0 off
PIVOT_WORKER=1
PIVOT_SIMULATOR=1

# --- Data on the server's disk (docs/match-data.md). Point it at a persistent volume, e.g. Dokploy's /data
PIVOT_DATA_DIR=/data
# Simulated matches generated at start (default 20, 0 for none). The site lists them by seed and opens the
# first. On the 2-core server the first start after a simulator change takes about 1.5 minutes for 20
# (each one is listed as soon as it is ready); later starts read them from PIVOT_DATA_DIR in seconds. To
# skip even that, make them on a many-core machine with scripts/sims_blob.py and use PIVOT_SIMS_BACKEND=blob.
PIVOT_SIM_MATCHES=20
# The AI's results are kept under PIVOT_DATA_DIR/results/ and read back on restart (0 keeps them in memory only)
PIVOT_RESULTS=1
# Change to any new value to make the AI write every result again
PIVOT_RESULTS_TAG=

# --- What-if replays (A09)
# Processes that replay the match (default: one less than the cores, at least 1)
PIVOT_WHATIF_WORKERS=
# Chips per pivot of the recorded demo to replay at start (default 2, 0 off); nothing to do while it is off
PIVOT_WHATIF_WARM=2
# What-if questions waiting at most; more get "busy, try again" (default 20)
PIVOT_WHATIF_MAX_QUEUED=20

# --- Narratives in other languages (Ax35)
# Languages written at start for every pivot of the matches below, both audiences, one at a time (default zh,es; 0 off)
# The same languages for the recorded demo's finished what-if comparisons, once the warm-up has run (Ax39)
PIVOT_PREWARM_LANGS=zh,es
# Matches to write them for (comma separated; default the recorded demo, i.e. none while it is off)
PIVOT_PREWARM_MATCHES=

# --- AI (Azure AI Foundry). Leave the endpoint empty to run without models.
# fake = canned explanations, detect = the real Judge / Explainer / Verifier workflow (D06)
PIVOT_PIPELINE=fake
PIVOT_FOUNDRY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
PIVOT_FOUNDRY_API_VERSION=2024-10-21
# Deployment names in Foundry; both may name the same deployment
PIVOT_MODEL_STANDARD=standard
PIVOT_MODEL_MINI=mini
# The VM is not in Azure, so the Azure login is a service principal with access to the Foundry resource
# (and to Cosmos DB and Blob below). Fill in all three: with AZURE_CLIENT_SECRET set the worker uses
# this service principal only, and never probes managed identity at 169.254.169.254 (on Oracle Cloud
# that address is OCI's metadata service).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure storage
# Where the AI's results are kept: files (default, under PIVOT_DATA_DIR/results/) or cosmos (Azure
# Cosmos DB, signed in with the AZURE_* service principal above; back to files if it cannot be reached)
PIVOT_RESULTS_BACKEND=files
PIVOT_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
PIVOT_COSMOS_DATABASE=pivot
# Where the simulated match files are kept: files (default, only the disk) or blob (Azure Blob Storage is
# the master copy and the disk a cache; if Blob cannot be reached the disk is used alone). docs/match-data.md
PIVOT_SIMS_BACKEND=files
PIVOT_BLOB_ENDPOINT=https://<account>.blob.core.windows.net/
# Blob container for the match files (default sims; made on first use)
PIVOT_BLOB_CONTAINER=sims
