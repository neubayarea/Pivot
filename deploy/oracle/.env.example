# Every setting the server reads. Copy to .env (cp .env.example .env) and fill in, or paste the
# lines into Dokploy's Environment tab. .env is ignored by git: never commit real values.

# --- Site
# Only `local` (one process, everything in memory or on disk) exists so far
PIVOT_PROFILE=local
# Public name of this VM. No domain? Use the public IP with sslip.io, e.g. 140.238.1.2 -> 140-238-1-2.sslip.io
PIVOT_DOMAIN=140-238-1-2.sslip.io
# Where browsers open the live WebSocket. docker-compose.yml builds it from PIVOT_DOMAIN; on Dokploy set it yourself
PIVOT_WS_URL=wss://140-238-1-2.sslip.io/api/ws

# Seed the small demo match on start (1) or start empty (0)
PIVOT_DEMO=1
# Worker and simulator inside the same process: 1 on, 0 off
PIVOT_WORKER=1
PIVOT_SIMULATOR=1

# --- Data on the server's disk (docs/match-data.md). Point it at a persistent volume, e.g. Dokploy's /data
PIVOT_DATA_DIR=/data
# Simulated matches generated at start (default 6, 0 for none)
PIVOT_SIM_MATCHES=6
# The AI's results are kept under PIVOT_DATA_DIR/results/ and read back on restart (0 keeps them in memory only)
PIVOT_RESULTS=1
# Change to any new value to make the AI write every result again
PIVOT_RESULTS_TAG=

# --- AI (Azure AI Foundry). Leave the endpoint empty to run without models.
# fake = canned explanations, detect = the real Judge / Explainer / Verifier workflow (D06)
PIVOT_PIPELINE=fake
PIVOT_FOUNDRY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
PIVOT_FOUNDRY_API_VERSION=2024-10-21
# Deployment names in Foundry; both may name the same deployment
PIVOT_MODEL_STANDARD=standard
PIVOT_MODEL_MINI=mini
# The VM is not in Azure, so the Azure login is a service principal with access to the Foundry resource
# (and to Cosmos DB and Blob below). Fill in all three: with AZURE_CLIENT_SECRET set the worker uses
# this service principal only, and never probes managed identity at 169.254.169.254 (on Oracle Cloud
# that address is OCI's metadata service).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure storage. Not read by the code yet: the Cosmos DB results store and the Blob match files
# are being built. Until then these lines change nothing.
PIVOT_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
PIVOT_COSMOS_DATABASE=pivot
PIVOT_BLOB_ENDPOINT=https://<account>.blob.core.windows.net/
