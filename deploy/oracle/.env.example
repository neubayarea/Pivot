# Copy to .env (cp .env.example .env) and fill in. .env is ignored by git: never commit real values.

# Public name of this VM. No domain? Use the public IP with sslip.io, e.g. 140.238.1.2 -> 140-238-1-2.sslip.io
PIVOT_DOMAIN=140-238-1-2.sslip.io
# Let's Encrypt contact for certificate expiry mail (optional)
ACME_EMAIL=

# Seed the small demo match on start (1) or start empty (0)
PIVOT_DEMO=1
# Worker and simulator inside the same process: 1 on, 0 off
PIVOT_WORKER=1
PIVOT_SIMULATOR=1

# --- AI (Azure AI Foundry), handed out by the D line. Leave empty to run without models.
# fake = canned explanations, detect = the real Judge / Explainer / Verifier workflow (D06)
PIVOT_PIPELINE=fake
PIVOT_FOUNDRY_ENDPOINT=
PIVOT_FOUNDRY_API_VERSION=2024-10-21
PIVOT_MODEL_STANDARD=
PIVOT_MODEL_MINI=
# The VM is not in Azure, so the Azure login is a service principal with access to the Foundry resource
# (DefaultAzureCredential reads these three).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
